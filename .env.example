# Basemap (MapLibre style JSON URL)
# Default: 国土地理院 pale raster via /geo/raster-basemap.json
# NEXT_PUBLIC_MAP_STYLE_URL=/geo/raster-basemap.json

# OpenFreeMap Liberty (vector; natural_earth only ~z7, tiles maxzoom 14):
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# NEXT_PUBLIC_MAP_MAX_ZOOM=14

# MapTiler A/B (requires your own key):
# NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_MAPTILER_KEY
# NEXT_PUBLIC_MAP_MAX_ZOOM=18

# Verbose map logging
# NEXT_PUBLIC_MAP_DEBUG=1
