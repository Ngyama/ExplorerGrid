# MapTiler (preferred Japan vector basemap)
# Get a key at https://cloud.maptiler.com/
NEXT_PUBLIC_MAPTILER_KEY=

# Optional full style URL override (wins over MapTiler key)
# NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/jp-mierune-streets/style.json?key=YOUR_KEY
# NEXT_PUBLIC_MAP_STYLE_URL=/geo/raster-basemap.json

# Optional max zoom override
# NEXT_PUBLIC_MAP_MAX_ZOOM=18

# Verbose map logging
# NEXT_PUBLIC_MAP_DEBUG=1
